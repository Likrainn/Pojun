# Docker 部署配置（复制为 .env）
POJUN_TAG=latest
# 镜像名：默认 ghcr.io/chu0119/pojun；拉取慢可换 Docker Hub 源
# POJUN_IMAGE=xingchuan1314/pojun
POSTGRES_USER=pojun
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pojun

# LLM（二选一或都填；也可留空到 UI 里配）
